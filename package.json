{
  "name": "v-tanks",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bunx --bun tsc --noEmit && bunx --bun vite build",
    "build:pages": "bunx --bun tsc --noEmit && bunx --bun vite build --base=/v-tanks/",
    "preview": "bunx --bun vite preview",
    "render:tanks": "bun tools/render-tanks.mjs",
    "test": "bun run build && bun test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "type": "module"
}
